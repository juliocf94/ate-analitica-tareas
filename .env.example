# Copiar como .env y rellenar. El archivo .env nunca se sube al repositorio.

# MongoDB: Atlas en la demo o local en desarrollo (mongodb://localhost:27017)
MONGODB_URI=
MONGODB_DB=ate

# S3: AWS en la demo o MinIO en desarrollo (S3_ENDPOINT_URL=http://localhost:9000)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
